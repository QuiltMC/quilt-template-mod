{
	"schema_version": 1,
	"quilt_loader": {
		"group": "${group}",
		"id": "example_mod",
		"version": "${version}",
		"metadata": {
			"name": "Mod Name",
			"description": "A short description of your mod.",
			"contributors": {
				"Your name here": "Owner"
			},
			"contact": {
				"homepage": "https://example.com/",
				"issues": "https://github.com/QuiltMC/quilt-template-mod/issues",
				"sources": "https://github.com/QuiltMC/quilt-template-mod"
			},
			"icon": "assets/example_mod/icon.png"
		},
		"intermediate_mappings": "net.fabricmc:intermediary",
		"entrypoints": {
			"main": "com.example.ExampleMod",
			"client": "com.example.client.ExampleModClient"
		},
		"depends": [
			{
				"id": "quilt_loader",
				"versions": ">=0.30.0-beta.7"
			},
			{
				"id": "fabric-api",
				"versions": "*"
			},
			{
				"id": "minecraft",
				"versions": ">=26.1.2"
			}
		]
	},
	"mixin": [
		"example_mod.mixins.json",
		{
			"config": "example_mod.client.mixins.json",
			"environment": "client"
		}
	]
}
